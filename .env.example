# Optional. Leave unset to run the site with the built-in local demo backend
# (catalogue, cart, orders, reviews and login all work in the browser).
# Fill these in to connect a real Supabase project instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional canonical web URL used in native product shares (no trailing route/hash).
VITE_PUBLIC_SITE_URL=https://milanorezaee2.github.io/Modara/

# Leave unset until a secure authenticated server endpoint for FCM/APNs tokens exists.
# The client will not request notification permission while this is unset.
VITE_PUSH_TOKEN_ENDPOINT=
